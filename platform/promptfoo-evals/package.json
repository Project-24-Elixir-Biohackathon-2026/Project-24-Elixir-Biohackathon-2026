{
  "name": "spe-evals",
  "private": true,
  "description": "Pins promptfoo for the SPE agent evaluations",
  "scripts": {
    "eval": "promptfoo eval -c promptfooconfig.yaml --no-cache --no-share -o reports/results.json",
    "eval:threats": "promptfoo eval -c threat-regressions.yaml --no-cache --no-share -o reports/threat-results.json"
  },
  "devDependencies": {
    "promptfoo": "0.125.1"
  }
}
