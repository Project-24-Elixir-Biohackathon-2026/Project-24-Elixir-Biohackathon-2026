# /etc/caddy/Caddyfile on the portal VM. Replace sperange.example.org with the
# real zone and fill in the ACME account from the Charité PKI.
{
	email you@bih-charite.de
	acme_ca https://ACME-DIRECTORY-URL-FROM-PKI
	acme_eab {
		key_id KEY-ID-FROM-PKI
		mac_key HMAC-KEY-FROM-PKI
	}
}

# The apex: the static site (landing page at /, threat catalog at /threats/,
# built by platform/site/build.py) and, for every other path, the Coder
# dashboard (/workspaces, /login, /api, ...).
sperange.example.org {
	root * /home/ubuntu/sperange/platform/site/dist
	@site path / /threats /threats/*
	handle @site {
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:7080
	}
}

# Every workspace app (openwebui--<agent>--<ws>--<user>.…).
*.sperange.example.org {
	reverse_proxy 127.0.0.1:7080
}
